{
  "name": "@bem/sdk.deps",
  "version": "1.0.0",
  "description": "Manage BEM dependencies",
  "license": "MPL-2.0",
  "homepage": "https://github.com/bem/bem-sdk/tree/master/packages/deps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bem/bem-sdk.git",
    "directory": "packages/deps"
  },
  "author": "Andrew Abramov <mail@blond.im>",
  "bugs": {
    "url": "https://github.com/bem/bem-sdk/issues?q=label%3Apkg%3Adeps"
  },
  "keywords": [
    "bem",
    "deps",
    "dependencies",
    "deps.js",
    "read",
    "parse",
    "resolve"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "mocha 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bem/sdk.cell": "workspace:^",
    "@bem/sdk.config": "workspace:^",
    "@bem/sdk.decl": "workspace:^",
    "@bem/sdk.entity-name": "workspace:^",
    "@bem/sdk.file": "workspace:^",
    "@bem/sdk.graph": "workspace:^",
    "@bem/sdk.walk": "workspace:^",
    "debug": "catalog:",
    "node-eval": "catalog:"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
