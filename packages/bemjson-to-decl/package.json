{
  "name": "@bem/sdk.bemjson-to-decl",
  "version": "1.0.0",
  "description": "BEMJSON to BEMDECL helper",
  "license": "MPL-2.0",
  "homepage": "https://github.com/bem/bem-sdk/tree/master/packages/bemjson-to-decl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bem/bem-sdk.git",
    "directory": "packages/bemjson-to-decl"
  },
  "author": "Vladimir Grinenko",
  "bugs": {
    "url": "https://github.com/bem/bem-sdk/issues?q=label%3Apkg%3Abemjson-to-decl"
  },
  "keywords": [
    "BEM",
    "bem",
    "bemjson",
    "deps",
    "converter"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "mocha 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bem/sdk.decl": "workspace:^",
    "@bem/sdk.entity-name": "workspace:^",
    "stringify-object": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
