{
  "name": "@bem/sdk.bemjson-to-jsx",
  "version": "1.0.0",
  "description": "Transform BEMJSON to JSX",
  "license": "MPL-2.0",
  "homepage": "https://github.com/bem/bem-sdk/tree/master/packages/bemjson-to-jsx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bem/bem-sdk.git",
    "directory": "packages/bemjson-to-jsx"
  },
  "author": "Vasiliy Loginevskiy <yeti.or@gmail.com>",
  "bugs": {
    "url": "https://github.com/bem/bem-sdk/issues?q=label%3Apkg%3Abemjson-to-jsx"
  },
  "keywords": [
    "bemjson",
    "jsx"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "mocha 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bem/sdk.entity-name": "workspace:^",
    "@bem/sdk.naming.entity.stringify": "workspace:^",
    "@bem/sdk.naming.presets": "workspace:^",
    "change-case": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
