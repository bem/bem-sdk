  ],
  "scripts": {
    "build": "tsc --build",
    "test": "mocha 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bem/sdk.bemjson-to-decl": "workspace:^",
    "@bem/sdk.entity-name": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
